{
  "name": "ribaunt",
  "version": "0.2.3",
  "description": "A PoW CAPTCHA library that provides stateless and secure user verification",
  "homepage": "https://ribaunt.com",
  "bugs": {
    "url": "https://github.com/ribaunt/ribaunt/issues"
  },
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./widget": {
      "client": "./dist/widget-browser.js",
      "default": "./dist/widget-browser.js",
      "types": "./dist/widget-browser.d.ts"
    },
    "./widget-react": {
      "client": "./dist/widget-react.js",
      "default": "./dist/widget-react.js",
      "types": "./dist/widget-react.d.ts"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "require": "./dist/cjs/redis.js"
    },
    "./worker": {
      "types": "./dist/solver-worker.d.ts",
      "default": "./dist/solver-worker.js"
    },
    "./worker-client": {
      "types": "./dist/worker-client.d.ts",
      "default": "./dist/worker-client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ribaunt/ribaunt.git"
  },
  "license": "GPL-3.0-only",
  "author": "ribaunt",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && tsc --project tsconfig.cjs.json && node scripts/prepare-cjs.mjs",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "test:coverage": "pnpm run build && vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "ioredis": "^6.0.0",
    "jsdom": "^27.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "ioredis": ">=5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  }
}
